# SentinelPOMDP Neo4j Environment Configuration
# Copy this file to .env in local root or infra/ for local development

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-a-unique-local-password>
NEO4J_DATABASE=neo4j
NEO4J_AUTH=neo4j/<same-unique-local-password>

# Connection pool settings
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=5.0
