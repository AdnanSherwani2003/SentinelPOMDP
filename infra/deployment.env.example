# Copy to a private file outside version control or inject these values through
# your secret manager. Every value here is a placeholder.
NEO4J_AUTH=neo4j/<set-a-unique-12+-character-password>
NEO4J_PASSWORD=<same-password-as-NEO4J_AUTH>
SENTINEL_API_KEY=<set-a-high-entropy-32+-character-api-key>
POSTGRES_PASSWORD=<set-a-unique-high-entropy-postgresql-password>

# The default deployment is offline: no paid provider and no external sharing.
SENTINEL_LLM_PROVIDER=fake
SENTINEL_EXTERNAL_LLM_ENABLED=0
SENTINEL_ALLOWED_LLM_PROVIDERS=

# Reviewer/admin capabilities are explicit. Omit review/manage for ordinary analysts.
SENTINEL_ROLES=analyst,reviewer
SENTINEL_PERMISSIONS=investigation:execute,evidence:read,provenance:read,trace:read,workflow:resume,document:upload,document:read,evidence:review,domain-pack:manage,calibration:run,evaluation:read,model:approve,job:submit,job:read,job:cancel,operations:read
SENTINEL_MAX_UPLOAD_BYTES=10485760
SENTINEL_MAX_UNCOMPRESSED_BYTES=52428800
SENTINEL_MAX_DOCUMENTS_PER_TENANT=100

# Optional explicit real-model mode. Keep unused credentials unset.
GROQ_API_KEY=<set-only-when-groq-is-authorized>
OPENAI_API_KEY=<set-only-when-openai-is-authorized>
