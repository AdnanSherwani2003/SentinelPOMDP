# Copy to .env for a local shell loader. Never commit the populated file.
GROQ_API_KEY=<set-in-local-environment>
OPENAI_API_KEY=<set-in-local-environment>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<set-a-unique-local-password>
NEO4J_DATABASE=neo4j

# External inference is fail-closed at the protected service boundary.
SENTINEL_EXTERNAL_LLM_ENABLED=0
SENTINEL_ALLOWED_LLM_PROVIDERS=groq
SENTINEL_DEVELOPMENT_AUTH=0
RUN_LIVE_GROQ_TESTS=0
RUN_LIVE_LLM_TESTS=0

# Implementation 12 local web application. Supply a 32+ character secret.
SENTINEL_API_KEY=<set-a-high-entropy-local-api-key>
SENTINEL_DEPLOYMENT_MODE=development
SENTINEL_PRINCIPAL_ID=local-analyst
SENTINEL_TENANT_ID=tenant_alpha
SENTINEL_ROLES=analyst,reviewer
SENTINEL_PERMISSIONS=investigation:execute,evidence:read,provenance:read,trace:read,workflow:resume,document:upload,document:read,evidence:review,domain-pack:manage,calibration:run,evaluation:read,model:approve
SENTINEL_DOCUMENT_STORE=data/company_documents
SENTINEL_MAX_UPLOAD_BYTES=10485760
SENTINEL_MAX_UNCOMPRESSED_BYTES=52428800
SENTINEL_MAX_DOCUMENTS_PER_TENANT=100
SENTINEL_BACKEND=memory
SENTINEL_LLM_PROVIDER=fake
SENTINEL_PLANNING_HORIZON=2
SENTINEL_MAX_TOOL_CALLS=3
SENTINEL_INVESTIGATION_BUDGET=1.0
SENTINEL_REQUEST_TIMEOUT_SECONDS=45
SENTINEL_RATE_LIMIT_PER_MINUTE=30
SENTINEL_LOGGING_MODE=structured
SENTINEL_CHECKPOINT_MODE=memory
SENTINEL_API_WORKERS=1
# For the full Docker demo, scripts/start_demo.ps1 creates isolated local values.
# PostgreSQL candidate deployments require a private connection URL.
SENTINEL_OPERATIONS_BACKEND=sqlite
SENTINEL_OPERATIONS_DATABASE=data/operations/sentinel-operations.db
SENTINEL_OPERATIONS_DATABASE_URL=
# Local Olist ZIP/directory. Raw records remain local and are never sent to an LLM by default.
SENTINEL_OLIST_DATA_PATH=
